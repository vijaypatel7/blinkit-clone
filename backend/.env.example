# ------------------------------------------------------------------
# Blinkit Clone — Backend environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# MongoDB (source of truth)
MONGODB_URI=mongodb://127.0.0.1:27017/blinkit
MONGODB_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000

# Redis (cache / sessions / OTP / rate-limit / queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_SESSION=2

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Delivery / geo
DEFAULT_SEARCH_RADIUS_METERS=5000
MAX_DELIVERY_DISTANCE_METERS=10000

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Observability
LOG_LEVEL=info

DOCKERHUB_USERNAME=your dockerhub_username

BACKEND_IMAGE=blinkit-clone-backend
FRONTEND_IMAGE=blinkit-clone-frontend

